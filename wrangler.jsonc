{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t212-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "kv_namespaces": [
    // Sem "id": o wrangler cria o KV automaticamente no primeiro deploy.
    { "binding": "OAUTH_KV" }
  ],
  "vars": {
    // URL EXATO a que o Claude se liga (acaba em /mcp). Preenche depois do 1.º deploy.
    "MCP_RESOURCE": "https://t212-mcp.O-TEU-SUBDOMINIO.workers.dev/mcp",
    // Limite de segurança por ordem, na moeda da conta (ex.: EUR)
    "MAX_ORDER_VALUE": "100"
  }
}
