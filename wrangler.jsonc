{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t212-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "kv_namespaces": [
    // KV já criado na conta (t212-mcp-oauth-kv)
    { "binding": "OAUTH_KV", "id": "a14f9723cac24434a942287d3943b036" }
  ],
  "vars": {
    // Limite de segurança por ordem, na moeda da conta (ex.: EUR)
    "MAX_ORDER_VALUE": "100"
  }
}
